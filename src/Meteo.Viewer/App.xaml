<Application x:Class="Meteo.Viewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Meteo.Viewer"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <local:HexToBrushConverter x:Key="HexToBrush" />
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="PanelBrush" Color="#F7F8FA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1F6FD1" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F6B7A" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>

        <!-- Selectable list item that looks like a chip / radio row -->
        <Style x:Key="ChipItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,1,4,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent" BorderBrush="#D5DAE1" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8EEF7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayBox" TargetType="Border">
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="BorderBrush" Value="#30000000" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Application.Resources>
</Application>
