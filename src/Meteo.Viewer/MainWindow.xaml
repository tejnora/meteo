<Window x:Class="Meteo.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Meteo.Viewer"
        xmlns:map="clr-namespace:Meteo.Viewer.Map"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainViewModel}"
        Title="Meteo ČR – plachtařská předpověď" Height="820" Width="1400"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedLayers" Source="{Binding Layers}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <DockPanel>
        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Background="#EEF0F3" BorderBrush="#D5DAE1" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Zrušit" Padding="10,1" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <ProgressBar DockPanel.Dock="Right" Width="220" Height="12" Value="{Binding Progress}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- side panel -->
        <Border DockPanel.Dock="Left" Width="270" Background="{StaticResource PanelBrush}" BorderBrush="#D5DAE1" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,12">
                    <TextBlock Text="Meteo ČR" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Plachtařská předpověď · ICON-D2 / ICON-EU" Foreground="{StaticResource MutedBrush}" FontSize="11" />

                    <Button Content="Aktualizovat předpověď" Margin="0,12,0,0" Padding="8,6" Command="{Binding UpdateCommand}" />
                    <Border Margin="0,8,0,0" Padding="8" CornerRadius="4" Background="#E8EEF7" BorderBrush="#B9C9E2" BorderThickness="1"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Probíhá aktualizace…" FontWeight="SemiBold" />
                            <ProgressBar Height="10" Margin="0,6" Value="{Binding Progress}" />
                            <TextBlock Text="{Binding UpdateStep}" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock Text="{Binding UpdateDetail}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                            <Button Content="Zrušit" HorizontalAlignment="Left" Padding="10,2" Margin="0,6,0,0" Command="{Binding CancelCommand}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DEN" Style="{StaticResource SectionHeader}" />
                    <ListBox ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource ChipItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="HODINA (místní čas)" Style="{StaticResource SectionHeader}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="◀" Width="26" Command="{Binding PrevHourCommand}" />
                        <Button DockPanel.Dock="Right" Content="▶" Width="26" Command="{Binding NextHourCommand}" />
                        <TextBlock Text="{Binding HourLabel}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="{Binding HourMax}" Value="{Binding HourIndex}" IsSnapToTickEnabled="True"
                            TickFrequency="1" TickPlacement="BottomRight" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding HourInfo}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />

                    <TextBlock Text="VRSTVA" Style="{StaticResource SectionHeader}" />
                    <ListBox ItemsSource="{Binding Source={StaticResource GroupedLayers}}" SelectedItem="{Binding SelectedLayer}"
                             BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ChipItem}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="ZOBRAZENÍ" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Reliéf" IsChecked="{Binding ShowRelief}" Margin="0,2" />
                    <CheckBox Content="Hranice" IsChecked="{Binding ShowBorders}" Margin="0,2" />
                    <CheckBox Content="Šipky větru" IsChecked="{Binding ShowArrows}" Margin="0,2" />

                    <Button Content="Exportovat vrstvu jako GeoJSON…" Margin="0,14,0,0" Padding="8,4" Command="{Binding ExportGeoJsonCommand}" />
                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Text="Kolečko myši = zoom, tažení = posun, dvojklik = celá mapa, ←/→ = hodina." />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedBrush}"
                               Text="Data: Deutscher Wetterdienst (ICON). Reliéf: Copernicus GLO-90 DEM. Hranice: Natural Earth." />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- map -->
        <Grid Background="#DCE6EE">
            <map:MapView ReliefLayer="{Binding ReliefLayer}" MeteoLayer="{Binding MeteoLayer}" BorderLayer="{Binding VisibleBorders}"
                         ShowArrows="{Binding ShowArrows}" WorldExtent="{Binding WorldExtent}" PointerWorld="{Binding PointerWorld}" />

            <Border Style="{StaticResource OverlayBox}" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OverlayBox}" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <ItemsControl ItemsSource="{Binding Legend}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Border Width="22" Height="12" Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                        BorderBrush="#40000000" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource OverlayBox}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PointerInfo}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding PointerInfo}" FontFamily="Consolas" FontSize="12" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
